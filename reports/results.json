  "cases": [
    {
      "id": "E01",
      "text": "Stripe Workbench shows an HTTP 307 on the webhook endpoint from our first sandbox test.",
      "expected": "stripe-redirect",
      "status": "resolve",
      "family": "Delivery redirect"
    },
    {
      "id": "E02",
      "text": "The Stripe event delivery endpoint returns HTTP 301. It is the new testing destination.",
      "expected": "stripe-redirect",
      "status": "resolve",
      "family": "Delivery redirect"
    },
    {
      "id": "E03",
      "text": "Our Stripe webhook URL is redirecting during the very first test.",
      "expected": "stripe-redirect",
      "status": "resolve",
      "family": "Delivery redirect"
    },
    {
      "id": "E04",
      "text": "Sandbox Stripe webhook returns a failed delivery, but the rep didn\u2019t capture the error.",
      "answers": {
        "symptom": "HTTP 302"
      },
      "expected": "stripe-redirect",
      "status": "resolve",
      "family": "Missing status"
    },
    {
      "id": "E05",
      "text": "Stripe invoices test fine but our webhook reports HTTP 503 in Workbench.",
      "expected": "stripe-server",
      "status": "escalate",
      "family": "Server error"
    },
    {
      "id": "E06",
      "text": "Stripe webhook endpoint reports a 500 every time our sandbox sends an event.",
      "expected": "stripe-server",
      "status": "escalate",
      "family": "Server error"
    },
    {
      "id": "E07",
      "text": "The Stripe webhook logs show 302 and 500 on different attempts. Which is it?",
      "answers": {
        "conflict": "HTTP 5xx"
      },
      "expected": "stripe-server",
      "status": "escalate",
      "family": "Conflicting evidence"
    },
    {
      "id": "E08",
      "text": "Stripe webhook is returning 401. The new integration otherwise seems set up.",
      "answers": {
        "symptom": "HTTP 401 auth required"
      },
      "expected": "review",
      "status": "escalate",
      "family": "Uncovered status"
    },
    {
      "id": "E09",
      "text": "Our Stripe webhook is redirecting, and the merchant reports duplicate charges.",
      "expected": "review",
      "status": "escalate",
      "family": "Financial impact"
    },
    {
      "id": "E10",
